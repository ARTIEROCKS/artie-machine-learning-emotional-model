# Add patterns of files DVC should ignore to improve performance.
# Learn more: https://dvc.org/doc/user-guide/dvcignore

# Python virtual environments
venv/
venv2/
.env

# IDE / VCS metadata
.idea/
.git/
.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary / logs
*.log
.tmp/
.temp/

# Ensure metrics directory is NOT ignored (negation pattern)
!metrics/
